<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon: the whole launcher icon (sea + ship) as a rounded square. Android 12+ masks splash
    icons to a circle (radius 36 of 108 units), so the square is scaled to 80 % to keep its corners
    inside it. The ship paths are copied from ic_launcher_foreground.xml: change both together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <clip-path android:pathData="M36,18 L72,18 A18,18 0 0 1 90,36 L90,72 A18,18 0 0 1 72,90 L36,90 A18,18 0 0 1 18,72 L18,36 A18,18 0 0 1 36,18 Z" />

        <!-- Sea, as in ic_launcher_background.xml -->
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="42"
                    android:gradientRadius="78"
                    android:type="radial">
                    <item
                        android:color="#FF1B2D4A"
                        android:offset="0" />
                    <item
                        android:color="#FF0A111C"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Soft drop shadow -->
        <group
            android:translateX="1.2"
            android:translateY="1.8">
            <group
                android:pivotX="54"
                android:pivotY="54"
                android:rotation="90">
                <path
                    android:fillColor="#59000000"
                    android:pathData="M46,80 L62,80 Q65,80 65,77 L65,38 C65,31 59.5,26.5 54,23.5 C48.5,26.5 43,31 43,38 L43,77 Q43,80 46,80 Z" />
            </group>
        </group>

        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="90">

        <!-- Flight deck -->
        <path android:pathData="M46,80 L62,80 Q65,80 65,77 L65,38 C65,31 59.5,26.5 54,23.5 C48.5,26.5 43,31 43,38 L43,77 Q43,80 46,80 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="54"
                    android:endY="80"
                    android:startX="54"
                    android:startY="24"
                    android:type="linear">
                    <item
                        android:color="#FFC9D3E1"
                        android:offset="0" />
                    <item
                        android:color="#FF8797AE"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Island (port side) -->
        <path
            android:fillColor="#FF5B6B83"
            android:pathData="M40.5,46 L44.5,46 L44.5,57 L40.5,57 Q39,57 39,55.5 L39,47.5 Q39,46 40.5,46 Z" />
        <path
            android:fillColor="#FF7D8DA5"
            android:pathData="M40.5,46 L44.5,46 L44.5,48 L39,48 L39,47.5 Q39,46 40.5,46 Z" />

        <!-- Waveform deck stripe -->
        <path
            android:pathData="M51.8,41 L56.2,41 M49,45 L59,45 M47,49 L61,49 M49.4,53 L58.6,53 M46.4,57 L61.6,57 M48,61 L60,61 M50.6,65 L57.4,65 M48.6,69 L59.4,69 M52,73 L56,73"
            android:strokeWidth="2.4"
            android:strokeColor="#FF3A78D6"
            android:strokeLineCap="round" />

        <!-- Download chevron at the bow -->
        <path
            android:pathData="M49.4,31.4 L54,36 L58.6,31.4"
            android:strokeWidth="2.6"
            android:strokeColor="#FF3A78D6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
