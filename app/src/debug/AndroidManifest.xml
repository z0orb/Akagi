<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug builds only: lets adb trigger a crash to test the crash logger. -->
        <receiver
            android:name=".DebugCrashReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.z0orb.akagi.DEBUG_CRASH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
